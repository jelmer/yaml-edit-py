"""Type stubs for the yaml-edit native extension."""

import os
from collections.abc import Iterable, Iterator
from typing import Any, Literal, TypeAlias, overload

from typing_extensions import Self

ScalarValueLike: TypeAlias = str | int | float | bool | None
Key: TypeAlias = ScalarValueLike | ScalarValue | Node | Scalar
Value: TypeAlias = (
    ScalarValueLike
    | ScalarValue
    | Node
    | Mapping
    | Sequence
    | Scalar
    | Alias
    | TaggedNode
    | dict[Any, Any]
    | list[Any]
    | tuple[Any, ...]
)
AliasPolicy: TypeAlias = Literal["refuse", "follow", "expand"]
ScalarStyle: TypeAlias = Literal[
    "plain", "single-quoted", "double-quoted", "literal", "folded"
]
StrPath: TypeAlias = str | os.PathLike[str]

class YamlError(ValueError):
    """Base class for the errors yaml_edit raises about YAML content."""

class ParseError(YamlError):
    """The text is not valid YAML."""

    line: int | None
    column: int | None

class PathError(YamlError):
    """A dotted path is malformed or cannot be followed."""

class ResolveError(YamlError):
    """An alias or merge key cannot be resolved."""

def byte_offset_to_line_column(text: str, offset: int) -> tuple[int, int]: ...

class Node:
    """A YAML node returned from a getter.

    Compares equal to the Python value it holds: ``doc["port"] == 8080``.
    """

    @property
    def kind(self) -> Literal["scalar", "mapping", "sequence", "alias", "tagged"]: ...
    def is_scalar(self) -> bool: ...
    def is_mapping(self) -> bool: ...
    def is_sequence(self) -> bool: ...
    def is_alias(self) -> bool: ...
    def is_tagged(self) -> bool: ...
    def as_alias(self) -> Alias | None: ...
    def as_tagged(self) -> TaggedNode | None: ...
    def as_scalar(self) -> Scalar | None: ...
    def as_mapping(self) -> Mapping | None: ...
    def as_sequence(self) -> Sequence | None: ...
    def as_int(self) -> int | None: ...
    def as_float(self) -> float | None: ...
    def as_bool(self) -> bool | None: ...
    def to_python(self) -> Any: ...
    def byte_range(self) -> tuple[int, int]: ...
    def start_position(self, source_text: str) -> tuple[int, int]: ...
    def end_position(self, source_text: str) -> tuple[int, int]: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class Alias:
