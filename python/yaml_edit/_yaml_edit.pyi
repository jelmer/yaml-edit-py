"""Type stubs for the yaml-edit native extension."""

from collections.abc import Iterator
from typing import Literal, TypeAlias

ScalarValue: TypeAlias = str | int | float | bool
AliasPolicy: TypeAlias = Literal["refuse", "follow", "expand"]
Value: TypeAlias = (
    ScalarValue | None | Node | Mapping | Sequence | Scalar | Alias | TaggedNode
)

class Node:
    """A YAML node returned from a getter."""

    @property
    def kind(self) -> str: ...
    def is_scalar(self) -> bool: ...
    def is_mapping(self) -> bool: ...
    def is_sequence(self) -> bool: ...
    def is_alias(self) -> bool: ...
    def is_tagged(self) -> bool: ...
    def as_alias(self) -> Alias | None: ...
    def as_tagged(self) -> TaggedNode | None: ...
    def as_scalar(self) -> Scalar | None: ...
    def as_mapping(self) -> Mapping | None: ...
    def as_sequence(self) -> Sequence | None: ...
    def as_int(self) -> int | None: ...
    def as_float(self) -> float | None: ...
    def as_bool(self) -> bool | None: ...
    def byte_range(self) -> tuple[int, int]: ...
    def start_position(self, source_text: str) -> tuple[int, int]: ...
    def end_position(self, source_text: str) -> tuple[int, int]: ...

class Alias:
    """An alias (``*name``) referring to an anchored node."""

    def __init__(self, name: str) -> None: ...
    def name(self) -> str: ...

class TaggedNode:
    """A node with an explicit tag, such as ``!custom value``."""

    def tag(self) -> str | None: ...
    def value(self) -> Scalar | None: ...
    def as_string(self) -> str | None: ...
    def as_mapping(self) -> Mapping | None: ...
    def as_sequence(self) -> Sequence | None: ...

class Comment:
    """A comment (``# ...``) in the source text."""

    def text(self) -> str: ...
    def content(self) -> str: ...
    def set_text(self, text: str) -> None: ...
    def set_content(self, content: str) -> None: ...
    def byte_range(self) -> tuple[int, int]: ...
    def start_position(self, source_text: str) -> tuple[int, int]: ...
    def end_position(self, source_text: str) -> tuple[int, int]: ...

class Scalar:
    """A scalar YAML value (string, number, boolean)."""

    def value(self) -> str:
        """The raw scalar text, preserving any surrounding quotes."""

    def as_string(self) -> str:
        """The scalar's value with quotes stripped if present."""
    def is_quoted(self) -> bool: ...
    def unquoted_value(self) -> str: ...
    def is_null(self) -> bool: ...
    def is_block(self) -> bool: ...
    def as_int(self) -> int | None: ...
    def as_float(self) -> float | None: ...
    def as_bool(self) -> bool | None: ...
    def set_value(self, value: str) -> None: ...
    def byte_range(self) -> tuple[int, int]: ...
    def start_position(self, source_text: str) -> tuple[int, int]: ...
    def end_position(self, source_text: str) -> tuple[int, int]: ...

class Entry:
    """A single key/value entry in a mapping.

    The fine-grained handle for mappings with repeated keys: each occurrence is
    a distinct entry that can be inspected and mutated individually.
    """

    def key(self) -> Node | None: ...
    def value(self) -> Node | None: ...
    def key_matches(self, key: str) -> bool: ...
    def set_value(self, value: Value) -> None: ...
    def remove(self) -> None: ...
    def byte_range(self) -> tuple[int, int]: ...
    def start_position(self, source_text: str) -> tuple[int, int]: ...
    def end_position(self, source_text: str) -> tuple[int, int]: ...

class Mapping:
    """A YAML mapping (key/value block)."""

    def __init__(self, flow: bool = False) -> None: ...
    def __len__(self) -> int: ...
    def is_empty(self) -> bool: ...
    def is_flow_style(self) -> bool: ...
    def contains_key(self, key: str) -> bool: ...
    def __contains__(self, key: str) -> bool: ...
    def get(self, key: str) -> Node | None: ...
    def __getitem__(self, key: str) -> Node: ...
    def get_mapping(self, key: str) -> Mapping | None: ...
    def get_sequence(self, key: str) -> Sequence | None: ...
    def set(self, key: str, value: Value) -> None: ...
    def __setitem__(self, key: str, value: Value) -> None: ...
    def remove(self, key: str) -> bool: ...
    def __delitem__(self, key: str) -> None: ...
    def rename_key(self, old_key: str, new_key: str) -> bool: ...
    def clear(self) -> None: ...
    def keys(self) -> list[str]: ...
    def values(self) -> list[Node]: ...
    def items(self) -> list[tuple[str, Node]]: ...
    def __iter__(self) -> Iterator[str]: ...
    def entries(self) -> list[Entry]: ...
    def find_entry(self, key: str) -> Entry | None: ...
    def find_all_entries(self, key: str) -> list[Entry]: ...
    def count_key(self, key: str) -> int: ...
    def remove_nth(self, key: str, n: int) -> bool: ...
    def get_path(
        self, path: str, alias_policy: AliasPolicy = "follow"
    ) -> Node | None: ...
    def set_path(
        self, path: str, value: Value, alias_policy: AliasPolicy = "refuse"
    ) -> None: ...
    def remove_path(self, path: str, alias_policy: AliasPolicy = "refuse") -> bool: ...
    def insert_after(self, after_key: str, key: str, value: Value) -> bool: ...
    def insert_before(self, before_key: str, key: str, value: Value) -> bool: ...
    def move_after(self, after_key: str, key: str, value: Value) -> bool: ...
    def move_before(self, before_key: str, key: str, value: Value) -> bool: ...
    def insert_at_index(self, index: int, key: str, value: Value) -> None: ...
    def reorder_fields(self, order: list[str]) -> None: ...
    def byte_range(self) -> tuple[int, int]: ...
    def start_position(self, source_text: str) -> tuple[int, int]: ...
    def end_position(self, source_text: str) -> tuple[int, int]: ...

class MergedMapping:
    """A read-only mapping view with aliases and merge keys (``<<``) resolved.

    Has no ``__str__``: a merged view has no single source span, so read its
    resolved contents through ``items``/``get`` rather than ``str()``.

    Raises ``ValueError`` when an alias or merge key cannot be resolved.
    """

    def __len__(self) -> int: ...
    def is_empty(self) -> bool: ...
    def contains_key(self, key: str) -> bool: ...
    def __contains__(self, key: str) -> bool: ...
    def get(self, key: str) -> Node | None: ...
    def __getitem__(self, key: str) -> Node: ...
    def get_merged(self, key: str) -> MergedMapping | None: ...
    def keys(self) -> list[str]: ...
    def values(self) -> list[Node]: ...
    def items(self) -> list[tuple[str, Node]]: ...
    def __iter__(self) -> Iterator[str]: ...

class Sequence:
    """A YAML sequence (list)."""

    def __init__(self, flow: bool = False) -> None: ...
    def __len__(self) -> int: ...
    def is_empty(self) -> bool: ...
    def is_flow_style(self) -> bool: ...
    def get(self, index: int) -> Node | None: ...
    def __getitem__(self, index: int) -> Node: ...
    def first(self) -> Node | None: ...
    def last(self) -> Node | None: ...
    def push(self, value: Value) -> None: ...
    def insert(self, index: int, value: Value) -> None: ...
    def set(self, index: int, value: Value) -> bool: ...
    def __setitem__(self, index: int, value: Value) -> None: ...
    def __delitem__(self, index: int) -> None: ...
    def remove(self, index: int) -> Node | None: ...
    def pop(self) -> Node | None: ...
    def clear(self) -> None: ...
    def values(self) -> list[Node]: ...
    def __iter__(self) -> Iterator[Node]: ...
    def byte_range(self) -> tuple[int, int]: ...
    def start_position(self, source_text: str) -> tuple[int, int]: ...
    def end_position(self, source_text: str) -> tuple[int, int]: ...

class Document:
    """A single YAML document."""

    def __init__(self) -> None: ...
    @staticmethod
    def parse(text: str) -> Document: ...
    @staticmethod
    def parse_relaxed(text: str) -> tuple[Document, list[str]]: ...
    def comments(self) -> list[Comment]: ...
    @staticmethod
    def from_file(path: str) -> Document: ...
    def to_file(self, path: str) -> None: ...
    def is_empty(self) -> bool: ...
    def as_mapping(self) -> Mapping | None: ...
    def as_sequence(self) -> Sequence | None: ...
    def as_scalar(self) -> Scalar | None: ...
    def as_tagged(self) -> TaggedNode | None: ...
    def merged(self) -> MergedMapping | None: ...
    def contains_key(self, key: str) -> bool: ...
    def __contains__(self, key: str) -> bool: ...
    def get(self, key: str) -> Node | None: ...
    def __getitem__(self, key: str) -> Node: ...
    def get_string(self, key: str) -> str | None: ...
    def set(self, key: str, value: Value) -> None: ...
    def __setitem__(self, key: str, value: Value) -> None: ...
    def remove(self, key: str) -> bool: ...
    def __delitem__(self, key: str) -> None: ...
    def rename_key(self, old_key: str, new_key: str) -> bool: ...
    def keys(self) -> list[str]: ...
    def get_path(
        self, path: str, alias_policy: AliasPolicy = "follow"
    ) -> Node | None: ...
    def set_path(
        self, path: str, value: Value, alias_policy: AliasPolicy = "refuse"
    ) -> None: ...
    def remove_path(self, path: str, alias_policy: AliasPolicy = "refuse") -> bool: ...
    def insert_after(self, after_key: str, key: str, value: Value) -> bool: ...
    def insert_before(self, before_key: str, key: str, value: Value) -> bool: ...
    def move_after(self, after_key: str, key: str, value: Value) -> bool: ...
    def move_before(self, before_key: str, key: str, value: Value) -> bool: ...
    def insert_at_index(self, index: int, key: str, value: Value) -> None: ...
    def reorder_fields(self, order: list[str]) -> None: ...
    def byte_range(self) -> tuple[int, int]: ...
    def start_position(self, source_text: str) -> tuple[int, int]: ...
    def end_position(self, source_text: str) -> tuple[int, int]: ...

class YamlFile:
    """A YAML stream, which may hold multiple documents and directives."""

    def __init__(self) -> None: ...
    @staticmethod
    def parse(text: str) -> YamlFile: ...
    @staticmethod
    def parse_relaxed(text: str) -> tuple[YamlFile, list[str]]: ...
    def comments(self) -> list[Comment]: ...
    @staticmethod
    def from_file(path: str) -> YamlFile: ...
    def __len__(self) -> int: ...
    def is_empty(self) -> bool: ...
    def documents(self) -> list[Document]: ...
    def document(self) -> Document | None: ...
    def ensure_document(self) -> Document: ...
    def push_document(self, document: Document) -> None: ...
    def directives(self) -> list[str]: ...
    def add_directive(self, directive_text: str) -> None: ...

def byte_offset_to_line_column(text: str, offset: int) -> tuple[int, int]: ...
