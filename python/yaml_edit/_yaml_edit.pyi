class Directive:
    """A directive line such as ``%YAML 1.2``; compares equal to its text."""

    @staticmethod
    def yaml_version(version: str) -> Directive: ...
    @staticmethod
    def tag(handle: str, prefix: str) -> Directive: ...
    def text(self) -> str: ...
    def name(self) -> str | None: ...
    def value(self) -> str | None: ...
    def is_yaml_version(self) -> bool: ...
    def is_tag(self) -> bool: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

