class MergedMapping:
    """A read-only mapping view with aliases and merge keys (``<<``) resolved.

    Has no ``__str__``: a merged view has no single source span, so read its
    resolved contents through ``items``/``get`` rather than ``str()``.

    Raises ``ResolveError`` when an alias or merge key cannot be resolved.
    """

    def __len__(self) -> int: ...
    def is_empty(self) -> bool: ...
    def contains_key(self, key: Key) -> bool: ...
    def __contains__(self, key: object) -> bool: ...
    @overload
    def get(self, key: Key) -> Node | None: ...
    @overload
    def get(self, key: Key, default: Any) -> Any: ...
    def __getitem__(self, key: Key) -> Node: ...
    def get_merged(self, key: Key) -> MergedMapping | None: ...
    def keys(self) -> list[Any]: ...
    def values(self) -> list[Node]: ...
    def items(self) -> list[tuple[Any, Node]]: ...
    def __iter__(self) -> Iterator[Any]: ...
    def to_python(self) -> dict[Any, Any]: ...

class Sequence:
    """A YAML sequence, with the ``list`` interface."""

    def __init__(self, flow: bool = False) -> None: ...
    def __len__(self) -> int: ...
    def is_empty(self) -> bool: ...
    def is_flow_style(self) -> bool: ...
    def get(self, index: int) -> Node | None: ...
    @overload
    def __getitem__(self, index: int) -> Node: ...
    @overload
    def __getitem__(self, index: slice) -> list[Node]: ...
    def first(self) -> Node | None: ...
    def last(self) -> Node | None: ...
    def append(self, value: Value) -> None: ...
    def extend(self, values: Iterable[Value]) -> None: ...
    def __iadd__(self, values: Iterable[Value]) -> Self: ...
    def reverse(self) -> None: ...
    def push(self, value: Value) -> None:
        """Deprecated alias of ``append``."""
    def insert(self, index: int, value: Value) -> None: ...
    def set(self, index: int, value: Value) -> bool: ...
    def __setitem__(self, index: int, value: Value) -> None: ...
    def __delitem__(self, index: int | slice) -> None: ...
    def remove(self, value: Value) -> Node | None:
        """Remove the first item equal to ``value``.

        Passing an ``int`` is deprecated and removes by index instead.
        """
    def pop(self, index: int = -1) -> Node: ...
    def index(self, value: Value, start: int = 0, stop: int | None = None) -> int: ...
    def count(self, value: Value) -> int: ...
    def __contains__(self, value: object) -> bool: ...
    def clear(self) -> None: ...
    def values(self) -> list[Node]: ...
    def __iter__(self) -> Iterator[Node]: ...
    def __reversed__(self) -> Iterator[Node]: ...
    def to_python(self) -> list[Any]: ...
    def byte_range(self) -> tuple[int, int]: ...
    def start_position(self, source_text: str) -> tuple[int, int]: ...
    def end_position(self, source_text: str) -> tuple[int, int]: ...
    def __eq__(self, other: object) -> bool: ...
    __hash__: None  # type: ignore[assignment]

class Violation:
    """A problem found by ``validate()``."""

    @property
    def message(self) -> str: ...
    @property
    def location(self) -> str | None: ...
    @property
    def byte_range(self) -> tuple[int, int] | None: ...
    @property
    def severity(self) -> str: ...
    @property
    def rule(self) -> str: ...

class SchemaViolation:
    """A scalar that ``validate_schema()`` found the schema does not allow."""

    @property
    def path(self) -> str: ...
    @property
    def message(self) -> str: ...
    @property
    def schema(self) -> str: ...

