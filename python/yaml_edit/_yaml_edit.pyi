    def __len__(self) -> int: ...
    def is_empty(self) -> bool: ...
    def is_flow_style(self) -> bool: ...
    def contains_key(self, key: Key) -> bool: ...
    def __contains__(self, key: object) -> bool: ...
    @overload
    def get(self, key: Key) -> Node | None: ...
    @overload
    def get(self, key: Key, default: Any) -> Any: ...
    def __getitem__(self, key: Key) -> Node: ...
    def get_mapping(self, key: Key) -> Mapping | None: ...
    def get_sequence(self, key: Key) -> Sequence | None: ...
    def set(
        self, key: Key, value: Value, *, field_order: Iterable[Key] | None = None
    ) -> None: ...
    def __setitem__(self, key: Key, value: Value) -> None: ...
    def remove(self, key: Key) -> bool: ...
    def __delitem__(self, key: Key) -> None: ...
    def pop(self, key: Key, *default: Any) -> Any: ...
    def popitem(self) -> tuple[Any, Node]: ...
    def setdefault(self, key: Key, default: Value = None) -> Node: ...
    def update(self, other: Any = None, **kwargs: Value) -> None: ...
    def rename_key(self, old_key: Key, new_key: Key) -> bool: ...
    def clear(self) -> None: ...
    def keys(self) -> list[Any]: ...
    def values(self) -> list[Node]: ...
